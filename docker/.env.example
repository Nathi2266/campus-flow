# Copy to docker/.env for local compose overrides (docker/.env is gitignored).
# NEVER commit docker/.env, root .env, /creds, certs, or cloud secret files.
# Production: set strong unique values and SPRING_PROFILES_ACTIVE=prod

POSTGRES_PASSWORD=campusflow123
JWT_SECRET=campusflow-dev-secret-key-min-32-bytes!!
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
SPRINGDOC_SWAGGER_UI_ENABLED=true

# Data policy: no mock campus by default
CAMPUSFLOW_SEED_DEMO=false
CAMPUSFLOW_BOOTSTRAP_ENABLED=true
CAMPUSFLOW_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CAMPUSFLOW_BOOTSTRAP_ADMIN_PASSWORD=Admin123!

# Optional: set CAMPUSFLOW_SEED_DEMO=true or use docker-compose.e2e.yml for demo pack / Playwright

# Production example:
# SPRING_PROFILES_ACTIVE=prod
# JWT_SECRET=<openssl rand -base64 48>
# POSTGRES_PASSWORD=<strong-password>
# CAMPUSFLOW_BOOTSTRAP_ADMIN_EMAIL=<your-admin>
# CAMPUSFLOW_BOOTSTRAP_ADMIN_PASSWORD=<strong-password>
# CAMPUSFLOW_SEED_DEMO=false
# CORS_ALLOWED_ORIGIN_PATTERNS=https://app.campusflow.edu
# SPRINGDOC_SWAGGER_UI_ENABLED=false
