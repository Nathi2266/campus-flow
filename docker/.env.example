# Copy to docker/.env for local compose overrides.
# Production: set strong unique values and SPRING_PROFILES_ACTIVE=prod

POSTGRES_PASSWORD=campusflow123
JWT_SECRET=campusflow-dev-secret-key-min-32-bytes!!
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
SPRINGDOC_SWAGGER_UI_ENABLED=true

# Production example:
# SPRING_PROFILES_ACTIVE=prod
# JWT_SECRET=<openssl rand -base64 48>
# POSTGRES_PASSWORD=<strong-password>
# CORS_ALLOWED_ORIGIN_PATTERNS=https://app.campusflow.edu
# SPRINGDOC_SWAGGER_UI_ENABLED=false
