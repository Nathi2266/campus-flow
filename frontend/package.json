{
  "name": "campusflow-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint src",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "node scripts/run-e2e-headed.mjs",
    "test:e2e:loop": "node scripts/e2e-loop.mjs",
    "test:e2e:walkthrough": "node scripts/run-e2e-and-preserve.mjs e2e/full-app-walkthrough.spec.ts",
    "test:e2e:full": "node scripts/run-e2e-and-preserve.mjs",
    "test:e2e:preserve-video": "node scripts/preserve-e2e-video.mjs"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.10.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.2",
    "axios": "^1.12.2",
    "framer-motion": "^12.23.22",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.63.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.3",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^27.0.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.4"
  }
}
